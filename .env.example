# Copy to apps/web/.env.local for local development.
# NEVER commit real values. Service-role keys are server-only.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Stripe TEST mode only for the MVP (leave empty to keep billing in demo state)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Integration adapters: leave empty to keep explicit "unavailable" states.
# A missing credential must never silently switch to fake success.
EPIC_SANDBOX_CLIENT_ID=
SYMPTOM_VENDOR_API_KEY=
DRUG_INTERACTION_DB_KEY=
